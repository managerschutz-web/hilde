<Window x:Class="Hilde.Desktop.CopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HILDE – Text zum Kopieren" Width="520" Height="340" MinWidth="380" MinHeight="240"
        WindowStartupLocation="CenterScreen" Topmost="True" FontFamily="{StaticResource UiFont}"
        Background="#FAFAFB" Icon="pack://application:,,,/Assets/hilde.ico">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Message" TextWrapping="Wrap" FontSize="14" Foreground="#1F2937" Margin="0,0,0,10"/>
        <TextBox x:Name="TextBox" Grid.Row="1" TextWrapping="Wrap" AcceptsReturn="True" FontSize="14"
                 VerticalScrollBarVisibility="Auto" Padding="8" BorderBrush="#D1D5DB"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="Copied" Text="Kopiert ✓" Foreground="#059669" VerticalAlignment="Center"
                       Margin="0,0,12,0" Visibility="Collapsed"/>
            <Button Content="Kopieren" Padding="18,6" IsDefault="True" Click="OnCopy" Margin="0,0,8,0"/>
            <Button Content="Schließen" Padding="18,6" IsCancel="True" Click="OnClose"/>
        </StackPanel>
    </Grid>
</Window>
