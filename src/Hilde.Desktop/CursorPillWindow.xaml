<Window x:Class="Hilde.Desktop.CursorPillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HILDE – Ablegen" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Focusable="False" IsHitTestVisible="False"
        SizeToContent="WidthAndHeight" Topmost="True" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">
    <Border Margin="8" CornerRadius="16" Padding="5,4,12,4" Background="#EE161A22" BorderBrush="#5534D399" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.4" Color="Black"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <Border Width="24" Height="24" CornerRadius="12" ClipToBounds="True">
                <Border.Background>
                    <ImageBrush ImageSource="pack://application:,,,/Assets/avatar.png" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="Snippet" Foreground="#F0F4FA" FontSize="12.5" MaxWidth="240" TextTrimming="CharacterEllipsis"/>
                <TextBlock Foreground="#8FA3B8" FontSize="11" Text="Klicken = hier einfügen · Rechtsklick/Esc = zurück"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
