<Window x:Class="Hilde.Desktop.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HILDE – Diktierfenster" Width="740" Height="460" MinWidth="620" MinHeight="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip"
        Topmost="True" ShowInTaskbar="True" UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/hilde.ico" FontFamily="{StaticResource UiFont}">

    <Window.Resources>
        <!-- Segment im KI-Block -->
        <Style x:Key="Seg" TargetType="Button">
            <Setter Property="Foreground" Value="#E8EDF4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="15" Padding="12,6" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#2EFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Runde bzw. pillenförmige Nebenaktion -->
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="#DCE3EC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="19" Padding="11,0" Background="#12FFFFFF" BorderBrush="#2A313D" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#26FFFFFF"/>
                                <Setter TargetName="B" Property="BorderBrush" Value="#3D4656"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Hauptaktion: Einfügen -->
        <Style x:Key="Hero" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="20" Padding="18,0,20,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2E6BFF" Offset="0"/>
                                    <GradientStop Color="#1FB98A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect x:Name="Glow" BlurRadius="16" ShadowDepth="0" Opacity="0.45" Color="#2E9BFF"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Mikrofon -->
        <Style x:Key="Mic" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="E" Fill="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="E" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="E" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <LinearGradientBrush x:Key="MicIdle" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2E6BFF" Offset="0"/>
            <GradientStop Color="#1FB98A" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="MicLive" Color="#EF4444"/>
    </Window.Resources>

    <Border Margin="10" CornerRadius="16" Background="#F5161A22" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <Grid Margin="14,10,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Kopf: zum Verschieben ziehen -->
            <Grid x:Name="Header" Background="Transparent" MouseLeftButtonDown="OnDrag" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="15">
                    <Border.Background>
                        <ImageBrush ImageSource="pack://application:,,,/Assets/avatar.png" Stretch="UniformToFill"/>
                    </Border.Background>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Diktierfenster" Foreground="#F0F4FA" FontSize="14" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#9CA3AF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Foreground="#9AA8BA" FontSize="12" Margin="6,0,0,0" Text="Bereit"/>
                        <Border Width="60" Height="4" CornerRadius="2" Background="#22FFFFFF" Margin="10,0,0,0"
                                VerticalAlignment="Center" x:Name="LevelTrack" Visibility="Collapsed">
                            <Border x:Name="LevelBar" Width="0" HorizontalAlignment="Left" CornerRadius="2" Background="#34D399"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Chip}" Margin="0" Padding="10,4" Click="OnClose"
                        ToolTip="Schließen (Text verwerfen)" Content="✕" FontSize="13" Background="Transparent"/>
            </Grid>

            <!-- Text, beim Kürzen/Klarer mit „Vorher“ daneben -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CompareCol" Width="0"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="ComparePane" Visibility="Collapsed" Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="VORHER" Foreground="#7F8CA0" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,5"/>
                    <TextBox x:Name="BeforeBox" Grid.Row="1" Style="{StaticResource Box}" IsReadOnly="True" Foreground="#AEB9C8"/>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="AfterLabel" Text="NEU VON HILDE – du kannst weiter ändern" Foreground="#7EF0B4"
                               FontSize="11" FontWeight="SemiBold" Margin="2,0,0,5" Visibility="Collapsed"/>
                    <TextBox x:Name="Editor" Grid.Row="1" Style="{StaticResource Box}" SpellCheck.IsEnabled="True"
                             Language="de-DE" PreviewKeyDown="OnEditorKey"/>
                    <TextBlock x:Name="Placeholder" Grid.Row="1" IsHitTestVisible="False" Margin="16,11,16,0"
                               Foreground="#5D6B7E" FontSize="15" TextWrapping="Wrap"
                               Text="Sprich einfach los – der Text erscheint hier. Du kannst jederzeit hineinklicken und ändern."/>
                </Grid>
            </Grid>

            <TextBlock x:Name="Notice" Grid.Row="3" Visibility="Collapsed" Margin="2,8,0,0" FontSize="12.5"
                       TextWrapping="Wrap" Foreground="#FCA5A5"/>

            <!-- Aktionsleiste -->
            <Border Grid.Row="4" Margin="-14,12,-14,-14" Padding="14,12,14,12" CornerRadius="0,0,16,16"
                    Background="#0AFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Mikrofon + Beschriftung -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid>
                            <Ellipse x:Name="Pulse" Width="46" Height="46" Fill="#EF4444" Opacity="0" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="PulseScale"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Button x:Name="DictateButton" Style="{StaticResource Mic}" Background="{StaticResource MicIdle}" Click="OnDictate"
                                    ToolTip="Diktat starten/beenden (oder Strg rechts zweimal tippen)">
                                <Grid>
                                    <Path x:Name="MicGlyph" Fill="White" Stretch="Uniform" Width="13" Height="19"
                                          Data="M6,0 C7.66,0 9,1.34 9,3 L9,9 C9,10.66 7.66,12 6,12 C4.34,12 3,10.66 3,9 L3,3 C3,1.34 4.34,0 6,0 Z M0,8 L1.5,8 C1.5,10.5 3.5,12.5 6,12.5 C8.5,12.5 10.5,10.5 10.5,8 L12,8 C12,11 9.8,13.5 6.75,13.9 L6.75,16 L5.25,16 L5.25,13.9 C2.2,13.5 0,11 0,8 Z"/>
                                    <Rectangle x:Name="StopGlyph" Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="White" Visibility="Collapsed"/>
                                </Grid>
                            </Button>
                        </Grid>
                        <StackPanel Margin="10,0,18,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DictateLabel" Text="Diktieren" Foreground="#F0F4FA" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DictateHint" Text="Strg rechts 2×" Foreground="#7F8CA0" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- KI-Block -->
                    <Border Grid.Column="1" CornerRadius="20" Background="#1A2029" BorderBrush="#2A313D" BorderThickness="1"
                            Padding="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Horizontal" Margin="9,0,4,0" VerticalAlignment="Center">
                                <Path Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"
                                      Data="M12,0 L14.2,8.6 L24,12 L14.2,15.4 L12,24 L9.8,15.4 L0,12 L9.8,8.6 Z">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#7AA7FF" Offset="0"/>
                                            <GradientStop Color="#5EEBB5" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                                <TextBlock Text="KI" Foreground="#9FB0C6" FontSize="11.5" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="ShortenButton" Style="{StaticResource Seg}" Click="OnShorten" ToolTip="Ganzen Text kürzen – oder nur die Markierung">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M0,1 L14,1 M0,6 L9,6 M0,11 L5,11" Stroke="#C9D3E1" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Kürzen" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Border x:Name="SegDivider" Width="1" Margin="2,7" Background="#2E3643"/>
                            <Button x:Name="ClarifyButton" Style="{StaticResource Seg}" Click="OnClarify" ToolTip="Ganzen Text sachlich und klar fassen – oder nur die Markierung">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M0,1 L14,1 M0,6 L14,6 M0,11 L14,11" Stroke="#C9D3E1" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Sachlich &amp; klar" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="AcceptButton" Style="{StaticResource Seg}" Click="OnAccept" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M0,6 L5,11 L14,1" Stroke="#5EEBB5" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Übernehmen" Margin="7,0,0,0" Foreground="#5EEBB5"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RevertButton" Style="{StaticResource Seg}" Click="OnRevert" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M5,1 L1,5 L5,9 M1,5 L10,5 C13,5 15,7 15,10 C15,13 13,14 10,14 L7,14" Stroke="#C9D3E1" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="13" Stretch="Uniform" VerticalAlignment="Center"/>
                                    <TextBlock Text="Vorher behalten" Margin="7,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Ablegen -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CopyButton" Style="{StaticResource Ghost}" Click="OnCopy" ToolTip="Kopieren (Markierung oder alles)" Margin="0,0,8,0">
                            <Grid>
                                <Path x:Name="CopyGlyph" Data="M5,5 L5,2.5 C5,1.7 5.7,1 6.5,1 L14.5,1 C15.3,1 16,1.7 16,2.5 L16,10.5 C16,11.3 15.3,12 14.5,12 L12,12 M2.5,5 L10.5,5 C11.3,5 12,5.7 12,6.5 L12,14.5 C12,15.3 11.3,16 10.5,16 L2.5,16 C1.7,16 1,15.3 1,14.5 L1,6.5 C1,5.7 1.7,5 2.5,5 Z"
                                      Stroke="#DCE3EC" StrokeThickness="1.6" Width="16" Height="16" Stretch="Uniform" StrokeLineJoin="Round"/>
                                <Path x:Name="CheckGlyph" Data="M0,6 L5,11 L14,1" Stroke="#5EEBB5" StrokeThickness="2.2" Width="15" Height="12"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button x:Name="OriginButton" Style="{StaticResource Ghost}" Click="OnOrigin" Visibility="Collapsed" Margin="0,0,8,0"
                                ToolTip="Dorthin einfügen, wo du beim Diktieren warst (Strg+Umschalt+Enter)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M6,1 L1,6 L6,11 M1,6 L11,6 C14,6 16,8 16,11 L16,14" Stroke="#DCE3EC" StrokeThickness="1.7"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="12" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock x:Name="OriginLabel" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="InsertButton" Style="{StaticResource Hero}" Click="OnInsert"
                                ToolTip="Strg+Enter – der Text hängt dann am Mauszeiger: dorthin klicken, wo er hin soll">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M1,1 L13,6.5 L7.5,8 L5.5,13.5 Z" Fill="White" Width="13" Height="14" Stretch="Uniform" VerticalAlignment="Center"/>
                                <TextBlock Text="Einfügen" Margin="8,0,0,1" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
