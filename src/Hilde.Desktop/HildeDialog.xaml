<Window x:Class="Hilde.Desktop.HildeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HILDE" Width="440" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" FontFamily="{StaticResource UiFont}">
    <Border Margin="14" CornerRadius="16" Background="#F7161A22" BorderBrush="#33FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="OnDrag">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid Margin="20,18,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Width="44" Height="44" CornerRadius="22" VerticalAlignment="Top" BorderThickness="2" x:Name="Ring" BorderBrush="#34D399">
                <Border.Background>
                    <ImageBrush ImageSource="pack://application:,,,/Assets/avatar.png" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                <TextBlock x:Name="TitleText" Foreground="#F0F4FA" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="MessageText" Foreground="#B8C4D4" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" LineHeight="19"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="NoButton" Style="{StaticResource Chip}" Click="OnNo" IsCancel="True"/>
                <Button x:Name="YesButton" Style="{StaticResource Primary}" Click="OnYes" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
