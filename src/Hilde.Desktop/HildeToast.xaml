<Window x:Class="Hilde.Desktop.HildeToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HILDE" Width="380" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        UseLayoutRounding="True" FontFamily="{StaticResource UiFont}">
    <Border x:Name="Card" Margin="12" CornerRadius="14" Background="#F7161A22" BorderBrush="#33FFFFFF" BorderThickness="1"
            Cursor="Hand" MouseLeftButtonUp="OnClick">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.45" Color="Black"/>
        </Border.Effect>
        <Grid Margin="14,12,10,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="18" VerticalAlignment="Top" BorderThickness="2" x:Name="Ring" BorderBrush="#34D399">
                <Border.Background>
                    <ImageBrush ImageSource="pack://application:,,,/Assets/avatar.png" Stretch="UniformToFill"/>
                </Border.Background>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,6,0">
                <TextBlock x:Name="TitleText" Foreground="#F0F4FA" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="MessageText" Foreground="#B8C4D4" FontSize="12.5" TextWrapping="Wrap" Margin="0,3,0,0" LineHeight="18"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource Chip}" Margin="0" Padding="8,3" Background="Transparent"
                    VerticalAlignment="Top" Content="✕" FontSize="11" Click="OnClose" ToolTip="Schließen"/>
        </Grid>
    </Border>
</Window>
