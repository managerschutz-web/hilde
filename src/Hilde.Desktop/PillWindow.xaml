<Window x:Class="Hilde.Desktop.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HILDE" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        SizeToContent="WidthAndHeight" Topmost="True" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}">
    <Border x:Name="Root" Margin="10" CornerRadius="22" Padding="6,5,8,5"
            Background="#D9161A22" BorderBrush="#33FFFFFF" BorderThickness="1"
            MouseLeftButtonDown="OnDragStart" ToolTip="HILDE – Strg rechts halten und sprechen">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="HILDE öffnen" Click="OnMenuOpen"/>
                <MenuItem Header="Pill ausblenden" Click="OnMenuHide"/>
                <Separator/>
                <MenuItem Header="HILDE beenden" Click="OnMenuQuit"/>
            </ContextMenu>
        </Border.ContextMenu>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Mikrofon: Klick startet/beendet die Freihandaufnahme -->
            <Border x:Name="MicButton" Width="32" Height="32" CornerRadius="16" Background="#26FFFFFF"
                    Cursor="Hand" MouseLeftButtonDown="OnButtonDown" MouseLeftButtonUp="OnMicClick" ToolTip="Freihand-Diktat starten/beenden">
                <Grid>
                    <Path x:Name="MicIcon" Fill="#F0F4FA" Stretch="Uniform" Width="12" Height="17"
                          Data="M6,0 C7.66,0 9,1.34 9,3 L9,9 C9,10.66 7.66,12 6,12 C4.34,12 3,10.66 3,9 L3,3 C3,1.34 4.34,0 6,0 Z M0,8 L1.5,8 C1.5,10.5 3.5,12.5 6,12.5 C8.5,12.5 10.5,10.5 10.5,8 L12,8 C12,11 9.8,13.5 6.75,13.9 L6.75,16 L5.25,16 L5.25,13.9 C2.2,13.5 0,11 0,8 Z"/>
                    <Ellipse x:Name="Spinner" Width="26" Height="26" StrokeThickness="2.5" Visibility="Collapsed"
                             Stroke="#60A5FA" StrokeDashArray="10 30" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,6,0">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#9CA3AF" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" Text="Bereit" Foreground="#E5E7EB" FontSize="13"
                           Margin="7,0,0,1" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Live-Pegel -->
            <StackPanel x:Name="LevelBars" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,8,0" Height="20">
                <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="#5534D399"/>
                <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="#5534D399"/>
                <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="#5534D399"/>
                <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="#5534D399"/>
                <Rectangle Width="3" Height="4" RadiusX="1.5" RadiusY="1.5" Margin="1,0" VerticalAlignment="Center" Fill="#5534D399"/>
            </StackPanel>

            <Border Width="26" Height="26" CornerRadius="13" Background="Transparent" Cursor="Hand" MouseLeftButtonDown="OnButtonDown"
                    MouseLeftButtonUp="OnExpandClick" ToolTip="HILDE öffnen">
                <Path Data="M0,0 L5,5 L10,0" Stroke="#C7CDD6" StrokeThickness="1.8" Width="10" Height="6"
                      Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
