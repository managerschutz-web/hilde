<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(HildeTfm)</TargetFramework>
    <RootNamespace>Hilde.EngineHost</RootNamespace>
    <AssemblyName>Hilde.Engine</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hilde.Core\Hilde.Core.csproj" />
    <ProjectReference Include="..\Hilde.Speech\Hilde.Speech.csproj" />
    <ProjectReference Include="..\Hilde.Language\Hilde.Language.csproj" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
    <!-- Native Laufzeiten nur im Engine-Prozess (HILDE.exe selbst lädt keine KI-Bibliotheken) -->
    <PackageReference Include="org.k2fsa.sherpa.onnx" />
    <PackageReference Include="Whisper.net.Runtime" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" ExcludeAssets="native" GeneratePathProperty="true" />
    <!-- CPU-Varianten (noavx/avx/avx2/avx512) haben gleiche Dateinamen: beim Publish nicht flach kopieren,
         sondern Ordnerstruktur erhalten – LLamaSharp wählt zur Laufzeit die passende Variante. -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" ExcludeAssets="native" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(PkgLLamaSharp_Backend_Cpu)\runtimes\win-x64\native\**\*" LinkBase="runtimes\win-x64\native"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
    <None Include="$(PkgLLamaSharp_Backend_Vulkan)\runtimes\win-x64\native\**\*" LinkBase="runtimes\win-x64\native"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
